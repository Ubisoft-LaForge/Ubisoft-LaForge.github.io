analytic

::begin parameters
float roughness 0.0 1.0 0.3
float metallic 0.0 1.0 0.0
float base_r 0.0 1.0 0.8
float base_g 0.0 1.0 0.4
float base_b 0.0 1.0 0.1
::end parameters

::begin shader
float sqr(float x) { return x*x; }

float D_GGX(float NdotH, float alpha) {
    float a2 = alpha * alpha;
    float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

float G1(float dp, float alpha) {
    float a2 = alpha * alpha;
    return 2.0 / (1.0 + sqrt(1.0 + a2 * (1.0 - dp*dp) / max(dp*dp, 1e-6)));
}

vec3 F_Schlick(float VdotH, vec3 F0) {
    return F0 + (1.0 - F0) * pow(1.0 - max(VdotH, 0.0), 5.0);
}

vec3 BRDF( vec3 L, vec3 V, vec3 N, vec3 X, vec3 Y )
{
    float NdotL = dot(N, L);
    float NdotV = dot(N, V);
    if (NdotL <= 0.0 || NdotV <= 0.0) return vec3(0.0);

    vec3 H = normalize(L + V);
    float NdotH = max(0.0, dot(N, H));
    float VdotH = max(0.0, dot(V, H));

    float alpha = max(roughness * roughness, 1e-4);
    vec3 baseColor = vec3(base_r, base_g, base_b);
    vec3 F0 = mix(vec3(0.04), baseColor, metallic);

    float D = D_GGX(NdotH, alpha);
    float G = G1(NdotL, alpha) * G1(NdotV, alpha);
    vec3 F = F_Schlick(VdotH, F0);

    vec3 specular = F * D * G / (4.0 * NdotL * NdotV);
    vec3 diffuse = (1.0 - F) * (1.0 - metallic) * baseColor / PI;

    return diffuse + specular;
}
::end shader

::begin isFunc
float sqr_is(float x) { return x*x; }

float D_GGX_is(float NdotH, float alpha) {
    float a2 = alpha * alpha;
    float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

float pdfBRDF(vec3 wi, vec3 wo, vec3 normal, vec3 tangent, vec3 bitangent)
{
    float alpha = max(roughness * roughness, 1e-4);
    vec3 h = normalize(wi + wo);
    float NdotH = max(0.0, dot(normal, h));
    float VdotH = max(1e-6, dot(wo, h));
    return D_GGX_is(NdotH, alpha) * NdotH / (4.0 * VdotH);
}

vec3 sampleBRDF(float u, float v, vec3 normal, vec3 tangent, vec3 bitangent, vec3 wo, out float pdf)
{
    float alpha = max(roughness * roughness, 1e-4);
    float phi = 2.0 * PI * v;
    float cosTheta2 = (1.0 - u) / (1.0 + (alpha*alpha - 1.0) * u);
    float cosTheta = sqrt(max(0.0, cosTheta2));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta2));

    vec3 h_local = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
    vec3 h = normalize(h_local.x * tangent + h_local.y * bitangent + h_local.z * normal);

    vec3 wi = reflect(-wo, h);

    float NdotL = dot(normal, wi);
    float NdotH = max(0.0, dot(normal, h));
    float VdotH = max(1e-6, dot(wo, h));

    if (NdotL <= 0.0) {
        pdf = 1.0;
        return normal;
    }

    pdf = max(0.001, D_GGX_is(NdotH, alpha) * NdotH / (4.0 * VdotH));
    return wi;
}
::end isFunc
