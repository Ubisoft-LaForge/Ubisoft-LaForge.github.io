float sqr(float x) { return x*x; }

float D_GGX(float NdotH, float alpha)
{
    return alpha*alpha / (PI * sqr(NdotH*NdotH*(alpha*alpha-1) + 1));    
}

float D_GGX_anisotropic(float HdotT, float HdotB, float NdotH, float alpha_x, float alpha_y)
{
    float ax = max(alpha_x, 1e-8);
    float ay = max(alpha_y, 1e-8);
    float t = sqr(HdotT / ax) + sqr(HdotB / ay) + NdotH * NdotH;
    return 1.0 / (PI * ax * ay * sqr(t));
}

float G1(float dp, float alpha)
{
    return 2/(1 + sqrt(1 + alpha*alpha * (1-dp*dp)/(dp*dp)));    
}

float G1_anisotropic(float VdotN, float VdotT, float VdotB, float alpha_x, float alpha_y)
{
    float vz2 = max(VdotN * VdotN, 1e-8);
    float ax2 = alpha_x * alpha_x;
    float ay2 = alpha_y * alpha_y;
    float a2_tan2 = (VdotT * VdotT) * ax2 + (VdotB * VdotB) * ay2;
    a2_tan2 = a2_tan2 / vz2;
    return 2.0 / (1.0 + sqrt(1.0 + a2_tan2));
}

float G_Smith_GGX(float LdotN, float VdotN, float alpha)
{
    return G1(LdotN, alpha) * G1(VdotN, alpha);
}

float G_Smith_GGX_anisotropic(
    float LdotN,
    float VdotN,
    float LdotT,
    float LdotB,
    float VdotT,
    float VdotB,
    float alpha_x,
    float alpha_y
)
{
    return G1_anisotropic(LdotN, LdotT, LdotB, alpha_x, alpha_y)
        * G1_anisotropic(VdotN, VdotT, VdotB, alpha_x, alpha_y);
}

vec2 ggx_alpha() { return vec2(alpha); }

float F_CookTorrance(float VdotH, float ior)
{
    float c = VdotH;
    float g = sqrt(ior*ior + c*c - 1.0);

    return 0.5 * pow(g-c,2) / pow(g+c,2) * (1 + pow(c*(g+c)-1,2) / pow(c*(g-c)+1,2));
}

float fd_lambert(float reflectance)
{
    return reflectance / PI;
}

float ior_to_f0(float ior)
{
    return sqr(ior-1.0) / sqr(ior+1.0);
}

vec3 log_scale(vec3 brdf, int n)
{
    vec3 scaled_brdf = brdf;
    for(int i=0; i<n; ++i)
        scaled_brdf = log(scaled_brdf+vec3(1.0));
    return scaled_brdf;
}

vec3 exp_scale(vec3 brdf, int n)
{
    vec3 scaled_brdf = brdf;
    for(int i=0; i<n; ++i)
        scaled_brdf = exp(scaled_brdf)-vec3(1.0);
    return scaled_brdf;
}

vec3 BRDF( vec3 L, vec3 V, vec3 N, vec3 X, vec3 Y )
{
    mat3 tbn = transpose(mat3(X, Y, N));

    vec3 wo = normalize(tbn * V);
    vec3 wi = normalize(tbn * L);

    float NdotL = dot(N, L);
    float NdotV = dot(N, V);

    if (NdotL < 0 || NdotV < 0) 
        return vec3(0);

    vec3 H = normalize(L+V);
    float NdotH = dot(N, H);
    float VdotH = dot(V, H);
    float HdotX = dot(H, X);
    float HdotY = dot(H, Y);
    float LdotX = dot(L, X);
    float LdotY = dot(L, Y);
    float VdotX = dot(V, X);
    float VdotY = dot(V, Y);

    vec2 ggx_alpha_params = ggx_alpha();
    float ax = ggx_alpha_params.x;
    float ay = ggx_alpha_params.y;

    vec3 diffuse_brdf = vec3(fd_lambert(diffuse_r), fd_lambert(diffuse_g), fd_lambert(diffuse_b));

    float D = D_GGX_anisotropic(HdotX, HdotY, NdotH, ax, ay);
    float G = G_Smith_GGX_anisotropic(NdotL, NdotV, LdotX, LdotY, VdotX, VdotY, ax, ay);
    vec3 F = vec3(  
                F_CookTorrance(VdotH, eta_r),     
                F_CookTorrance(VdotH, eta_g), 
                F_CookTorrance(VdotH, eta_b)
            );

    vec3 specular_brdf = F * D * G / (4.0 * NdotL * NdotV);

    vec3 brdf = diffuse_brdf + specular_brdf;
    vec3 analytic_brdf = brdf;

    // --- auto generated neural BRDF code ---
	vec3 analytic_output = analytic_brdf;

	vec4 f0_0 = vec4(wi.r, wi.g, wi.b, wo.r);
	vec4 f0_1 = vec4(wo.g, wo.b, latent_0, latent_1);
	vec2 f0_2 = vec2(latent_2, latent_3);
	vec4 f3_0;
	vec2 f3_1;

	mlp_eval(f0_0, f0_1, f0_2, f3_0, f3_1);
	vec3 neural_output = vec3(f3_0.r, f3_0.g, f3_0.b);
	vec3 neural_gate = vec3(f3_0.a, f3_1.r, f3_1.g);
	neural_output = exp(1.000000*(neural_output) + 0.000000);
	neural_gate = sigmoid(neural_gate);
	vec3 neural_brdf = relu(neural_output + neural_gate * analytic_output);
	// --- end of auto generated neural BRDF code ---

    if (show_ggx)
        return analytic_brdf;
    
    if (show_diff)
        return vec3(length(abs(neural_brdf-analytic_brdf)));
    
    if (show_correction)
        return neural_output;

    if (show_gate)
        return neural_gate/3.14159265;

    return neural_brdf;
}
::end shader

::begin isFunc

float pdfBRDF(vec3 wi, vec3 wo, vec3 normal, vec3 tangent, vec3 bitangent) {
    vec3 h = normalize(wi+wo);
    float NdotH = dot(normal, h);
    vec2 ggx_alpha_params = ggx_alpha();
    float ax = ggx_alpha_params.x;
    float ay = ggx_alpha_params.y;
    float HdotT = dot(tangent, h);
    float HdotB = dot(bitangent, h);
    float ph = D_GGX_anisotropic(HdotT, HdotB, NdotH, ax, ay) * max(NdotH, 0.0);
    return ph / (4.0*max(dot(wo, h), 1e-6));
}

// https://agraphicsguy.wordpress.com/2015/11/01/sampling-microfacet-brdf/
//float theta = acos(sqrt((1.0f - v) / ((a*a - 1.0f) * v + 1.0f) ));

vec3 sampleBRDF( float u, float v, vec3 normal, vec3 tangent, vec3 bitangent, vec3 wo, out float pdf )
{
    vec2 ggx_alpha_params = ggx_alpha();
    float ax = max(ggx_alpha_params.x, 1e-6);
    float ay = max(ggx_alpha_params.y, 1e-6);

    // Transformation cartésien -> sphérique -> direction
    float phi_h = atan(ay * sin(2.0 * PI * u), ax * cos(2.0 * PI * u));
    float cos_phi = cos(phi_h);
    float sin_phi = sin(phi_h);
    float alpha2 = 1.0 / (sqr(cos_phi) / sqr(ax) + sqr(sin_phi) / sqr(ay));
    float tan2_theta = v / max(1.0 - v, 1e-6);
    float cos_theta = 1.0 / sqrt(1.0 + alpha2 * tan2_theta);
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    vec3 wh = vec3(sin_theta * cos_phi, sin_theta * sin_phi, cos_theta);

    // Transposition vers repère camera et reflection de wh
    vec3 es_wh = wh.x * tangent + wh.y * bitangent + wh.z * normal;
    es_wh = normalize(es_wh);
    //vec3 wi = reflect(wo, es_wh);
    vec3 wi = -wo - 2.0*dot(es_wh, -wo) * es_wh;

    // Calcul pdf
    float NdotH = dot(normal, es_wh);
    float HdotT = dot(tangent, es_wh);
    float HdotB = dot(bitangent, es_wh);
    float ph = D_GGX_anisotropic(HdotT, HdotB, NdotH, ax, ay) * max(NdotH, 0.0);
    pdf = ph / (4.0*max(dot(wo, es_wh), 1e-6));

    return wi;
}
::end isFunc
