::begin shader
float relu(float x) { return max(x, 0.0);                      }
vec2 relu(vec2 x)   { return max(x, vec2(0.0, 0.0));           }
vec3 relu(vec3 x)   { return max(x, vec3(0.0, 0.0, 0.0));      }
vec4 relu(vec4 x)   { return max(x, vec4(0.0, 0.0, 0.0, 0.0)); }

float hardGeLU(float x) { return mix(mix(x*0.0, x * (x + 1.5) / 3.0, step(-1.5, x)), x, step(1.5, x)); }
vec2 hardGeLU(vec2 x)   { return mix(mix(x*0.0, x * (x + 1.5) / 3.0, step(-1.5, x)), x, step(1.5, x)); }
vec3 hardGeLU(vec3 x)   { return mix(mix(x*0.0, x * (x + 1.5) / 3.0, step(-1.5, x)), x, step(1.5, x)); }
vec4 hardGeLU(vec4 x)   { return mix(mix(x*0.0, x * (x + 1.5) / 3.0, step(-1.5, x)), x, step(1.5, x)); }

float identity(float x) { return x; }
vec2 identity(vec2 x) { return x; }
vec3 identity(vec3 x) { return x; }
vec4 identity(vec4 x) { return x; }
float sigmoid(float x) { return 1.0 / (1.0 + exp(-x)); }
vec2 sigmoid(vec2 x) { return 1.0 / (1.0 + exp(-x)); }
vec3 sigmoid(vec3 x) { return 1.0 / (1.0 + exp(-x)); }
vec4 sigmoid(vec4 x) { return 1.0 / (1.0 + exp(-x)); }
